<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    tools:context=".SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.BahaBarla.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvDeviceId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/orange_id"
                        android:textIsSelectable="true"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="ID : b8d212330298ec03" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/server_address"
                        android:textAppearance="@style/TextAppearance.BahaBarla.FieldLabel" />

                    <EditText
                        android:id="@+id/etServer"
                        style="@style/Widget.BahaBarla.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint=""
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        tools:ignore="LabelFor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/database_name"
                        android:textAppearance="@style/TextAppearance.BahaBarla.FieldLabel" />

                    <EditText
                        android:id="@+id/etDatabase"
                        style="@style/Widget.BahaBarla.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint=""
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        tools:ignore="LabelFor" />

                    <!-- The person's own SQL Server login. The bridge opens the
                         database with it, so SQL Server decides what they see. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/user_name"
                        android:textAppearance="@style/TextAppearance.BahaBarla.FieldLabel" />

                    <EditText
                        android:id="@+id/etUser"
                        style="@style/Widget.BahaBarla.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint=""
                        android:importantForAutofill="no"
                        android:inputType="text|textNoSuggestions"
                        android:maxLines="1"
                        tools:ignore="LabelFor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/password"
                        android:textAppearance="@style/TextAppearance.BahaBarla.FieldLabel" />

                    <EditText
                        android:id="@+id/etPassword"
                        style="@style/Widget.BahaBarla.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint=""
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        tools:ignore="LabelFor" />

                    <!-- Kept on the phone only; the card works dollars out from it. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/usd_rate"
                        android:textAppearance="@style/TextAppearance.BahaBarla.FieldLabel" />

                    <EditText
                        android:id="@+id/etUsdRate"
                        style="@style/Widget.BahaBarla.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint=""
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:digits="0123456789.,"
                        android:maxLines="1"
                        tools:ignore="LabelFor" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/save_settings"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/blue_search"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogOut"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/log_out"
                android:textColor="@color/blue_search"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
